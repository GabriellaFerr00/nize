# Names only — never put real values in this file or anywhere in the repository.
# Real values live in: Render (runtime), GitHub Secrets/Environments (pipeline), Cloudflare Pages (proxy).

# Backend runtime (Render, profile prod)
SPRING_PROFILES_ACTIVE=prod
NIZE_JWT_SECRET=
# Must include sslMode=REQUIRED (or VERIFY_CA / VERIFY_IDENTITY); the app refuses to start otherwise.
NIZE_DB_URL=
NIZE_DB_USER=
NIZE_DB_PASSWORD=

# Migration step only (GitHub Environment "production")
NIZE_DB_MIGRATION_URL=
NIZE_DB_MIGRATION_USER=
NIZE_DB_MIGRATION_PASSWORD=

# Cloudflare Pages Function (Pages project settings → Variables), e.g. https://nize-api.onrender.com
API_ORIGIN=

# Front build: none. The SPA calls /api on its own origin (D-15), so there is no VITE_API_URL.
